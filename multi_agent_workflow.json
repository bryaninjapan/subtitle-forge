{
  "workflow": {
    "name": "subtitle_forge_multi_agent_pipeline",
    "version": "1.0",
    "description": "A Multi-Agent Orchestration Blueprint for Subtitle Forge"
  },
  "global_context": {
    "required_inputs": [
      "video_path"
    ],
    "optional_inputs": [
      "language",
      "style"
    ]
  },
  "agents": [
    {
      "id": "preflight_agent",
      "role": "Environment preparation and pre-flight checks",
      "action": "extract_audio_and_validate",
      "inputs": [
        "video_path",
        "working_directory"
      ],
      "outputs": [
        "audio_16khz_path",
        "working_directory"
      ],
      "dependencies": [],
      "retry_policy": {
        "max_retries": 1,
        "delay_seconds": 5
      }
    },
    {
      "id": "asr_agent",
      "role": "Speech-to-text transcription",
      "action": "transcribe_audio",
      "inputs": [
        "audio_16khz_path",
        "language",
        "working_directory"
      ],
      "outputs": [
        "raw_srt_text",
        "transcript_text"
      ],
      "dependencies": [
        "preflight_agent"
      ],
      "retry_policy": {
        "max_retries": 3,
        "backoff_multiplier": 2.0,
        "base_delay_seconds": 10
      }
    },
    {
      "id": "study_notes_agent",
      "role": "Synthesize transcript into comprehensive study notes",
      "action": "generate_study_notes",
      "inputs": [
        "transcript_text",
        "frame_paths",
        "working_directory"
      ],
      "outputs": [
        "study_notes_md"
      ],
      "dependencies": [
        "asr_agent"
      ],
      "retry_policy": {
        "max_retries": 2,
        "delay_seconds": 15
      }
    }
  ],
  "engine_rules": {
    "execution_mode": "concurrent_dag",
    "on_failure": "halt_branch_and_trigger_recover_py",
    "state_persistence": "write_to_working_directory"
  }
}
